# ────────────────────────────────────────────────────────────────────────
# EmoSense AI — Environment Configuration
# ────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust values for your environment.
# All variables have sensible defaults and are optional.

# Server
HOST=127.0.0.1
PORT=8080

# CORS — comma-separated list of allowed origins (* = all)
CORS_ORIGINS=*

# Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# Model directory (relative to backend/, or absolute path)
MODEL_DIR=model
